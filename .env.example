# --- Front-end config (Vite). Safe to expose; NO secrets here. ---
# Point the app at the deployed DocuSign signing backend to switch the
# "Send for signature" flow from the built-in pad to real DocuSign.
VITE_SIGN_API_URL=https://qpjswujpidkirshwirfw.supabase.co/functions/v1/docusign-sign

# Supabase publishable (anon) key — sent as the gateway apikey header. Public.
VITE_SUPABASE_ANON_KEY=sb_publishable_qIVoBbkgL9YO7MYnDjH5cQ_BaRtg7tD

# Optional: must match APP_SHARED_SECRET set on the Edge Function (defense-in-depth).
# VITE_SIGN_APP_SECRET=
